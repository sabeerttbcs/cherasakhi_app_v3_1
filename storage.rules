rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Quiz question images: hidden until the quiz start time, admin upload only.
    match /quizzes/{quizId}/{fileName} {
      allow read: if request.auth != null
        && request.time >= firestore.get(/databases/(default)/documents/quizzes/$(quizId)).data.startTime;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Expense receipts: any signed-in member can view; registered members
    // (trip participants log their own bills) and admins can upload images.
    match /events/{eventId}/receipts/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
